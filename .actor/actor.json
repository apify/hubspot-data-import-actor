{
    "actorSpecification": 1,
    "name": "hubspot-data-import-actor",
    "title": "HubSpot Company Data Import",
    "description": "Import data from an Apify dataset into multiple HubSpot company records, matching dataset items to companies via URL.",
    "version": "0.0",
    "buildTag": "latest",
    "meta": {
        "templateId": "js-empty"
    },
    "dockerfile": "../Dockerfile",
    "defaultRunOptions": {
        "memoryMbytes": 1024
    },
    "storages": {
        "dataset": {
            "actorSpecification": 1,
            "title": "Import Summary",
            "description": "Summary of the HubSpot import operation",
            "views": {
                "companies": {
                    "title": "Companies",
                    "description": "Per-company import summary rows (kind = 'company')",
                    "transformation": {
                        "fields": [
                            "kind",
                            "companyId",
                            "companyUrl",
                            "status",
                            "created",
                            "updated",
                            "skipped",
                            "rowsTotal",
                            "error"
                        ]
                    },
                    "display": {
                        "component": "table"
                    }
                },
                "contacts": {
                    "title": "Contacts",
                    "description": "Per-contact write results (kind = 'contact')",
                    "transformation": {
                        "fields": [
                            "kind",
                            "companyId",
                            "displayName",
                            "identifier",
                            "status",
                            "propertiesWritten"
                        ]
                    },
                    "display": {
                        "component": "table"
                    }
                }
            }
        }
    },
    "input": "./input_schema.json",
    "output": "./output_schema.json"
}
