{
    "actorSpecification": 1,
    "name": "hubspot-data-import-actor",
    "title": "HubSpot Company Data Import",
    "description": "Import data from an Apify dataset into a HubSpot company record with flexible field mapping.",
    "version": "0.0",
    "buildTag": "latest",
    "meta": {
        "templateId": "js-empty"
    },
    "dockerfile": "../Dockerfile",
    "storages": {
        "dataset": {
            "actorSpecification": 1,
            "title": "Import Summary",
            "description": "Summary of the HubSpot import operation",
            "views": {
                "overview": {
                    "title": "Import Overview",
                    "transformation": {
                        "fields": [
                            "success",
                            "companyId",
                            "propertiesUpdated",
                            "duration"
                        ]
                    },
                    "display": {
                        "component": "table"
                    }
                }
            }
        }
    },
    "input": "./input_schema.json",
    "output": "./output_schema.json"
}
